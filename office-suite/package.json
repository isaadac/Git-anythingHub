{
  "name": "atlas-office",
  "productName": "Atlas Office",
  "version": "1.0.0",
  "description": "A free, cross-platform office suite: Atlas Write (documents), Atlas Sheets (spreadsheets) and Atlas Slides (presentations).",
  "main": "src/main/main.js",
  "author": {
    "name": "isaadac",
    "email": "isaac.a.adekanmi@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "live-server": "node src/main/collab-server.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "docx": "9.15.0",
    "electron-updater": "6.6.2",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "pptxgenjs": "4.0.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "homepage": "https://github.com/isaadac/Git-anythingHub",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaadac/Git-anythingHub.git"
  },
  "build": {
    "appId": "io.github.isaadac.atlasoffice",
    "productName": "Atlas Office",
    "copyright": "Copyright © 2026 isaadac",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word Document",
        "description": "Word Document",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": "xlsx",
        "name": "Excel Workbook",
        "description": "Excel Workbook",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": "xls",
        "name": "Excel 97-2003 Workbook",
        "role": "Editor",
        "mimeType": "application/vnd.ms-excel"
      },
      {
        "ext": "ods",
        "name": "OpenDocument Spreadsheet",
        "role": "Editor",
        "mimeType": "application/vnd.oasis.opendocument.spreadsheet"
      },
      {
        "ext": "csv",
        "name": "CSV File",
        "role": "Editor",
        "mimeType": "text/csv"
      },
      {
        "ext": "pptx",
        "name": "PowerPoint Presentation",
        "description": "PowerPoint Presentation",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "ext": "aslides",
        "name": "Atlas Presentation",
        "role": "Editor",
        "mimeType": "application/x-atlas-slides"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signtoolOptions": {
        "publisherName": "isaadac"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atlas Office",
      "artifactName": "Atlas-Office-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Atlas-Office-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "isaadac <isaac.a.adekanmi@gmail.com>",
      "synopsis": "Documents, spreadsheets and presentations",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/isaadac/Git-anythingHub/releases/latest/download"
    },
    "artifactName": "Atlas-Office-${version}-${arch}.${ext}"
  },
  "desktopName": "atlas-office.desktop"
}
